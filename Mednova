let quizSet=[],quizIndex=0,quizCorrect=0,quizAnswered=false;
function startQuiz(){let topic=$("quizTopic").value;quizSet=quizBank.filter(q=>topic==="all"||q.topic===topic).sort(()=>Math.random()-.5);quizIndex=0;quizCorrect=0;$("quizIntro").classList.add("hidden");$("quizResult").classList.add("hidden");$("quizQuestionBox").classList.remove("hidden");showQuizQuestion()}
