async function upload(type){let isPdf=type==="pdf",file=$(isPdf?"pdfFile":"vidFile").files[0],title=$(isPdf?"pdfTitle":"vidTitle").value.trim(),cat=$(isPdf?"pdfCat":"vidCat").value;if(!file||!title){$("adminMsg").textContent="Please enter a title and select a file.";return}if(isPdf&&!file.name.toLowerCase().endsWith(".pdf")){$("adminMsg").textContent="Please choose a PDF file.";return}if(!isPdf&&!file.type.startsWith("video/")){$("adminMsg").textContent="Please choose a video file.";return}try{await saveFile({type,title,category:cat,name:file.name,blob:file,created:Date.now()});$("adminMsg").textContent="Uploaded successfully on this device.";$(isPdf?"pdfTitle":"vidTitle").value="";$(isPdf?"pdfFile":"vidFile").value="";refreshFiles()}catch(e){$("adminMsg").textContent="Upload failed. File may be too large for local browser storage."}}
