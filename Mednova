const DB="MedNovaProFiles",STORE="files";
function openDB(){return new Promise((res,rej)=>{let r=indexedDB.open(DB,1);r.onupgradeneeded=()=>r.result.createObjectStore(STORE,{keyPath:"id",autoIncrement:true});r.onsuccess=()=>res(r.result);r.onerror=()=>rej(r.error)})}
function saveFile(o){return new Promise((res,rej)=>{let r=db.transaction(STORE,"readwrite").objectStore(STORE).add(o);r.onsuccess=()=>res(r.result);r.onerror=()=>rej(r.error)})}
function allFiles(){return new Promise((res,rej)=>{let r=db.transaction(STORE).objectStore(STORE).getAll();r.onsuccess=()=>res(r.result);r.onerror=()=>rej(r.error)})}
function removeFile(id){return new Promise((res,rej)=>{let r=db.transaction(STORE,"readwrite").objectStore(STORE).delete(id);r.onsuccess=()=>res();r.onerror=()=>rej(r.error)})}
function fillCategories(){["pdfCat","vidCat"].forEach(id=>{let s=$(id);s.innerHTML="";courses.forEach(c=>{let o=document.createElement("option");o.value=c.title;o.textContent=c.title;s.append(o)})})}
async function refreshFiles(){let fs=await allFiles();$("pdfCount").textContent=fs.filter(x=>x.type==="pdf").length;$("videoCount").textContent=fs.filter(x=>x.type==="video").length;drawFiles(fs)}
function makeFileRow(f,canDelete){let row=document.createElement("div");row.className="file-row";let info=document.createElement("div");info.innerHTML=`<strong>${f.type==="pdf"?"📄":"🎬"} ${escapeHtml(f.title)}</strong><small>${escapeHtml(f.category)} • ${escapeHtml(f.name)}</small>`;let acts=document.createElement("div");acts.style.display="flex";acts.style.gap="7px";let open=document.createElement("button");open.className="btn";open.textContent=f.type==="pdf"?"Open":"Play";open.onclick=()=>openFile(f);let dl=document.createElement("button");dl.className="btn";dl.textContent="Download";dl.onclick=()=>downloadFile(f);acts.append(open,dl);if(canDelete){let del=document.createElement("button");del.className="btn";del.textContent="Delete";del.onclick=async()=>{if(confirm("Delete this file?")){await removeFile(f.id);refreshFiles()}};acts.append(del)}row.append(info,acts);return row}
function escapeHtml(s){return String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]))}
function drawFiles(fs){let me=JSON.parse(sessionStorage.getItem("mlp_user")||"{}"),admin=me.role==="admin";["pdfList","videoList"].forEach(id=>$(id).innerHTML="");fs.filter(x=>x.type==="pdf").forEach(f=>$("pdfList").append(makeFileRow(f,admin)));fs.filter(x=>x.type==="video").forEach(f=>$("videoList").append(makeFileRow(f,admin)));if(!fs.some(x=>x.type==="pdf"))$("pdfList").innerHTML='<div class="muted" style="padding:15px">No PDF notes uploaded yet.</div>';if(!fs.some(x=>x.type==="video"))$("videoList").innerHTML='<div class="muted" style="padding:15px">No video lectures uploaded yet.</div>';let q=$("pdfSearch").value.toLowerCase();if(q){$("pdfList").querySelectorAll(".file-row").forEach(r=>r.classList.toggle("hidden",!r.textContent.toLowerCase().includes(q)))}}
